{
	"$schema": "node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"html": {
		// Experimental in 2.5.x: full .astro support (frontmatter, script, style,
		// template). Biome pinned exact — formatting may churn between minors.
		"experimentalFullSupportEnabled": true
	},
	"javascript": {
		"globals": ["Bun"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			// Off: framework rules that misread .astro templates, resolver rules that
			// can't see astro: virtual modules or Bun's hoisting, and style rules that
			// fight the codebase (hex design tokens, math constants, terse ternaries).
			"correctness": {
				"noNodejsModules": "off",
				"useImportExtensions": "off",
				"noUndeclaredDependencies": "off",
				"noUnresolvedImports": "off",
				"useJsxKeyInIterable": "off",
				"useQwikValidLexicalScope": "off"
			},
			"complexity": {
				"noExcessiveLinesPerFunction": "off",
				"noExcessiveCognitiveComplexity": "off",
				"noVoid": "off",
				"useMaxParams": "off"
			},
			"suspicious": {
				"noUnnecessaryConditions": "off",
				"noBitwiseOperators": "off",
				"noEvolvingTypes": "off",
				"noUnknownAttribute": "off",
				"noEmptyBlockStatements": "off",
				"noLeakedRender": "off",
				"noReactSpecificProps": "off"
			},
			"performance": {
				"useSolidForComponent": "off",
				"useTopLevelRegex": "off"
			},
			"style": {
				"noExcessiveLinesPerFile": "off",
				"noDescendingSpecificity": "off",
				"noContinue": "off",
				"useForOf": "off",
				"useFilenamingConvention": "off",
				"useBlockStatements": "off",
				"noTernary": "off",
				"noMagicNumbers": "off",
				"noJsxLiterals": "off",
				"noHexColors": "off",
				"noImplicitBoolean": "off",
				"noIncrementDecrement": "off",
				"noDefaultExport": "off",
				"useExportsLast": "off",
				"useConsistentTypeDefinitions": "off",
				"useDestructuring": "off",
				"useNamingConvention": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!apps/home/public",
			"!.github",
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.jsonc",
			"**/*.css",
			"**/*.astro"
		]
	},
	"overrides": [
		{
			// A port of binji/wasm-clang's WASI core. It keeps upstream's idioms
			// (parameter reassignment, parameter properties) so the two stay diffable.
			"includes": ["apps/home/src/playground/clang/driver.ts"],
			"linter": {
				"rules": {
					"preset": "recommended",
					"suspicious": { "noConsole": "off" }
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
