{
	"$schema": "node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"html": {
		// Experimental in 2.5.x: full .astro support (frontmatter, script, style,
		// template). Biome pinned exact — formatting may churn between minors.
		"experimentalFullSupportEnabled": true
	},
	"javascript": {
		"globals": ["Bun"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			// Disabled: framework rules that misread .astro
			// templates, resolver rules blind to astro: virtuals / bun hoisting,
			// and taste rules that contradict the codebase idiom (hex design
			// tokens, sim math constants, terse ternaries).
			"correctness": {
				"noNodejsModules": "off",
				"useImportExtensions": "off",
				"noUndeclaredDependencies": "off",
				"noUnresolvedImports": "off",
				"useJsxKeyInIterable": "off",
				"useQwikValidLexicalScope": "off"
			},
			"complexity": {
				"noExcessiveLinesPerFunction": "off",
				"noVoid": "off",
				"useMaxParams": "off"
			},
			"suspicious": {
				"noUnnecessaryConditions": "off",
				"noBitwiseOperators": "off",
				"noEvolvingTypes": "off",
				"noUnknownAttribute": "off",
				"noEmptyBlockStatements": "off",
				"noLeakedRender": "off",
				"noReactSpecificProps": "off"
			},
			"performance": {
				"useSolidForComponent": "off"
			},
			"style": {
				"noExcessiveLinesPerFile": "off",
				"noDescendingSpecificity": "off",
				"noContinue": "off",
				"useForOf": "off",
				"useFilenamingConvention": "off",
				"useBlockStatements": "off",
				"noTernary": "off",
				"noMagicNumbers": "off",
				"noJsxLiterals": "off",
				"noHexColors": "off",
				"noImplicitBoolean": "off",
				"noIncrementDecrement": "off",
				"noDefaultExport": "off",
				"useExportsLast": "off",
				"useConsistentTypeDefinitions": "off",
				"useDestructuring": "off",
				"useNamingConvention": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!apps/blog/public",
			"!apps/home/public",
			"!.github",
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.jsonc",
			"**/*.css",
			"**/*.astro"
		]
	},
	"overrides": [
		{
			// Blog predates the strict pins.
			// Its idioms are intentional; revisit when the blog is reworked.
			"includes": ["apps/blog/**", "shared/**", "workers/**"],
			"linter": {
				"rules": {
					"preset": "recommended",
					"style": {
						"noNonNullAssertion": "off"
					},
					"a11y": {
						"useSemanticElements": "off",
						"useAriaPropsSupportedByRole": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
