---
/**
 * Scrollytelling: a pinned figure that advances through steps as the reader
 * scrolls the prose beside it, as on distill.pub. Put a <Figure scrolly={id}>
 * in the `figure` slot and a sequence of <Step> in the default slot; each step
 * entering the viewport centre sets the figure's data-step, which the D3 layer
 * reads to emphasise that stage.
 */
interface Props {
	id: string;
}
const { id } = Astro.props;
---

<div class="scrolly" data-scrolly={id}>
	<div class="scrolly-figure">
		<div class="scrolly-figure-inner"><slot name="figure" /></div>
	</div>
	<div class="scrolly-steps"><slot /></div>
</div>
