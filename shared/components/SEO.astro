---
/**
 * Shared SEO head block: canonical, robots, OpenGraph (+ article tags), Twitter
 * cards, and JSON-LD structured data (BlogPosting for posts, WebSite + Person for
 * pages). Both apps import this; the blog passes article metadata for rich results.
 * The layout still owns <title>; this owns everything else machine-readable.
 */
interface Props {
	title: string;
	description: string;
	canonicalURL?: URL | string | undefined;
	image?: string | undefined;
	type?: "website" | "article" | undefined;
	siteName?: string | undefined;
	author?: string | undefined;
	publishedTime?: Date | undefined;
	modifiedTime?: Date | undefined | undefined;
	tags?: string[] | undefined;
}

const {
	title,
	description,
	canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin),
	image,
	type = "website",
	siteName = "Conor Scheidt",
	author = "Conor Scheidt",
	publishedTime,
	modifiedTime,
	tags = [],
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonical = canonicalURL.toString();
const imageURL = image ? new URL(image, origin).toString() : undefined;

const jsonLd =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: title,
				description,
				...(imageURL ? { image: imageURL } : {}),
				url: canonical,
				mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
				datePublished: publishedTime?.toISOString(),
				dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
				keywords: tags.join(", ") || undefined,
				author: { "@type": "Person", name: author, url: "https://crsche.com" },
				publisher: { "@type": "Person", name: author, url: "https://crsche.com" },
			}
		: {
				"@context": "https://schema.org",
				"@graph": [
					{ "@type": "WebSite", name: siteName, url: origin.toString(), description },
					{
						"@type": "Person",
						name: author,
						url: "https://crsche.com",
						sameAs: ["https://github.com/crsche"],
					},
				],
			};
---

<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<link rel="canonical" href={canonical} />

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
{
	type === "article" && (
		<>
			{publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)}
			{(modifiedTime ?? publishedTime) && (
				<meta
					property="article:modified_time"
					content={(modifiedTime ?? publishedTime)!.toISOString()}
				/>
			)}
			<meta property="article:author" content={author} />
			{tags.map((t) => (
				<meta property="article:tag" content={t} />
			))}
		</>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
