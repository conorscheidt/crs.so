---
/**
 * Declarative figure. Author a typed spec in MDX; the D3 layer
 * (shared/scripts/figures) renders it with the shared LaTeX theme and wires
 * cross-refs + scrollytelling. One component for charts, flows, schematics.
 */
import type { FigSpec } from "../scripts/figures/types";

interface Props {
	spec: FigSpec;
	caption?: string;
	n?: number;
	/** scrollytelling: belongs to a <Scrolly> with this id (becomes the pinned figure) */
	scrolly?: string;
}
const { spec, caption, n, scrolly } = Astro.props;
// guard against a literal closing script tag breaking the inline JSON island
const json = JSON.stringify(spec).replace(/</g, "\\u003c");
---

<figure class="fig" data-fig data-scrolly={scrolly}>
	<div class="fig-canvas">
		<svg role="img" aria-label={caption ?? "figure"}></svg>
	</div>
	<script type="application/json" class="fig-spec" set:html={json}></script>
	{
		caption && (
			<figcaption class="caption">
				{n != null && <span class="fig-num">Fig.&thinsp;{n}</span>}
				{caption}
			</figcaption>
		)
	}
</figure>
