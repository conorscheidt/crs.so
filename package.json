{
	"name": "crs-so",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"deploy": "bun run --filter '*' deploy",
		"test": "bun test",
		"check": "cd apps/home && wrangler types worker/worker-configuration.d.ts >/dev/null && tsc -p worker && cd ../.. && biome check . && astro check --root apps/home --minimumSeverity error",
		"fix": "biome check --write ."
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/mdx": "^8.0.3",
		"@astrojs/rss": "^4.0.19",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@fontsource/spectral": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@replit/codemirror-vim": "^6.4.0",
		"d3-axis": "^3.0.0",
		"d3-drag": "^3.0.0",
		"d3-force": "^3.0.0",
		"d3-format": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"katex": "^0.19.0",
		"lenis": "1.3.26",
		"minisearch": "7.2.0",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sucrase": "^3.35.1",
		"valibot": "1.5.0",
		"wabt": "^1.0.39"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/sitemap": "^3.7.4",
		"@biomejs/biome": "2.5.15",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@types/bun": "^1.4.2",
		"@types/d3-axis": "^3.0.6",
		"@types/d3-drag": "^3.0.7",
		"@types/d3-force": "^3.0.10",
		"@types/d3-format": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-shape": "^3.2.0",
		"@webgpu/types": "^0.1.74",
		"astro": "^7.3.8",
		"fontkit": "^2.0.4",
		"sharp": "^0.35.5",
		"typescript": "^6.0.3",
		"wawoff2": "^2.0.1",
		"wrangler": "4.149.0"
	},
	"overrides": {
		"katex": "0.19.0",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14"
	}
}
