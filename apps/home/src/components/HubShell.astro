---
import { blurb, contact, education, experience, place, resumeHref } from "../data/about";
import { repoUrl } from "../data/projects";
import { publishedPosts } from "../lib/posts";
import { projectsWithPosts } from "../lib/relations";
import type { Section } from "../router";

type Props = { section: Section };
const { section } = Astro.props;

const posts = await publishedPosts();
const projects = await projectsWithPosts();
const latest = posts[0];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
const year = new Date().getUTCFullYear();
/** The colophon is dev-only until its copy is written, both here and at
 *  the route itself (pages/colophon/[...slug].astro). */
const showColophon = import.meta.env.DEV;
---

<div class="hub" data-section={section}>
	<header class="col-l">
		<a class="name press inkable" href="/">Conor<br />Scheidt</a>
		<p class="role">software · mathematics</p>
		<nav aria-label="Sections">
			<a href="/" aria-current={section === "index" ? "page" : undefined}>Index</a>
			<a href="/projects" aria-current={section === "projects" ? "page" : undefined}>Projects</a>
			<a href="/writing" aria-current={section === "writing" ? "page" : undefined}>Writing</a>
			<a href="/about" aria-current={section === "about" ? "page" : undefined}>About</a>
		</nav>
		<div class="meta">
			<a href={resumeHref} target="_blank" rel="noopener">résumé ↗</a>
			<a href="https://git.crs.so" rel="me">git.crs.so ↗</a>
			<button type="button" data-theme-toggle aria-label="Toggle day and night">
				<svg class="ecl" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
					<circle class="ring" cx="8" cy="8" r="5.5"></circle>
					<circle class="disc" cx="8" cy="8" r="5.5"></circle>
				</svg>
				<span data-theme-label>day</span>
			</button>
		</div>
	</header>

	<div class="col-c">
		<canvas id="sim" aria-hidden="true"></canvas>
	</div>

	<div class="col-r">
		<section class="panel" data-panel="index" aria-label="Latest">
			<h2 class="sr-only" data-panel-head tabindex="-1">Index</h2>
			{
				latest && (
					<div class="latest">
						<p class="ptitle">Latest</p>
						<a class="latest-title inkable" href={`/writing/${latest.id}`}>
							{latest.data.title}
						</a>
						<p class="entry-meta">
							{fmt(latest.data.date)} · {latest.data.minutes} min
						</p>
						<p class="entry-desc">{latest.data.description}</p>
						<div class="tags">
							{latest.data.tags?.map((t: string) => (
								<button type="button" class="tag" data-tag={t}>
									{t}
								</button>
							))}
						</div>
					</div>
				)
			}
			{
				!latest && (
					<div class="latest">
						<p class="ptitle">Latest</p>
						<p class="hollow-lead">Nothing published yet.</p>
					</div>
				)
			}
			<div class="gitb" data-git hidden>
				<p class="ptitle">git.crs.so</p>
				<div class="hm" data-git-heat></div>
				<p class="gitreadout" data-git-readout></p>
				<p class="gitline" data-git-totals></p>
				<div data-git-detail>
					<p class="ptitle sub">Popular repositories</p>
					<div data-git-repos></div>
					<p class="ptitle sub">Recent</p>
					<div data-git-recent></div>
				</div>
			</div>
		</section>

		<section class="panel" data-panel="projects" aria-label="Projects">
			<h2 class="sr-only" data-panel-head tabindex="-1">Projects</h2>
			{
				projects.length > 0 && (
					<div class="search" data-search="project">
						<span class="chips" data-chips />
						<input
							type="search"
							placeholder="search projects · # tags"
							aria-label="Search projects"
						/>
					</div>
				)
			}
			<div class="list" data-scroll>
				<div>
					{
						projects.length === 0 && (
							<div class="hollow">
								<p class="hollow-lead">Nothing here yet.</p>
								</div>
						)
					}
					{
						projects.map((p) => (
							<article
								class="entry"
								data-id={`project:${p.slug}`}
								data-ts={String(Date.UTC(p.year, 6, 1))}
								data-tags={p.tags.join(" ")}
							>
								<span class="entry-title inkable">{p.name}</span>
								<p class="entry-desc">{p.description}</p>
								<div class="xrefs">
									{p.repo && (
										<a class="xref" href={repoUrl(p.repo)} rel="noopener">
											repository ↗
										</a>
									)}
									{p.href && (
										<a class="xref" href={p.href} rel="noopener">
											live ↗
										</a>
									)}
									{p.posts.map((post) => (
										<a class="xref" href={`/writing/${post.id}`}>
											{post.data.title}
										</a>
									))}
								</div>
								<div class="tags">
									{p.tags.map((t) => (
										<button type="button" class="tag" data-tag={t}>
											{t}
										</button>
									))}
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="panel" data-panel="writing" aria-label="Writing">
			<h2 class="sr-only" data-panel-head tabindex="-1">Writing</h2>
			{
				posts.length > 0 && (
					<div class="search" data-search="post">
						<span class="chips" data-chips />
						<input
							type="search"
							placeholder="search posts · # tags · years"
							aria-label="Search writing"
						/>
					</div>
				)
			}
			<div class="list" data-scroll>
				<div>
					{
						posts.length === 0 && (
							<div class="hollow">
								<p class="hollow-lead">No posts yet.</p>
								</div>
						)
					}
					{
						posts.map((post) => (
							<article
								class="entry"
								data-id={`post:${post.id}`}
								data-ts={String(post.data.date.valueOf())}
								data-tags={post.data.tags?.join(" ")}
							>
								<a class="entry-title inkable" href={`/writing/${post.id}`}>
									{post.data.title}
								</a>
								<p class="entry-meta">
									{fmt(post.data.date)} · {post.data.minutes} min
								</p>
								<div class="tags">
									{post.data.tags?.map((t: string) => (
										<button type="button" class="tag" data-tag={t}>
											{t}
										</button>
									))}
									{post.data.draft && <i class="sample">draft</i>}
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="panel" data-panel="about" aria-label="About">
			<h2 class="sr-only" data-panel-head tabindex="-1">About</h2>
			<div class="list" data-scroll>
				<div>
					<p class="blurb">{blurb}</p>
					<div class="links">
						<a href={`mailto:${contact.email}`}>{contact.email}</a>
						<a href={contact.github} rel="me">github ↗</a>
						<a href={contact.linkedin} rel="me">linkedin ↗</a>
						<a href={resumeHref} target="_blank" rel="noopener">résumé ↗</a>
					</div>
					<p class="ptitle">Education</p>
					{
						education.map((e) => (
							<div class="cvrow">
								<h3>{e.school}</h3>
								<span>
									{e.degree} · {e.span}
								</span>
							</div>
						))
					}
					<p class="ptitle sub">Experience</p>
					{
						experience.map((e) => (
							<div class="cvrow">
								<h3>{e.role}</h3>
								<span>
									{e.org} · {e.span}
								</span>
								<p>{e.detail}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>

	<footer class="corner">
		<span>{place.city}</span>
		<span class="clock" data-clock data-tz={place.tz}></span>
		<span>
			© {year}
			{showColophon && <>&#32;· <a href="/colophon">colophon</a></>}
		</span>
	</footer>
</div>

<script>
	import "../app";
</script>
