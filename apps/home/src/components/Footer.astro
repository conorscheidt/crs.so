---
import { SITE_CONFIG } from "@shared/config";

const year = new Date().getFullYear();
---

<footer class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t border-rule pt-6">
	<span class="meta">© {year} Conor Scheidt</span>
	<nav class="flex flex-wrap gap-x-6 gap-y-1 text-[14px]">
		<a href={`mailto:${SITE_CONFIG.meta.email}`} class="link">{SITE_CONFIG.meta.email}</a>
		<a href={SITE_CONFIG.urls.github} class="link">GitHub</a>
		<a href={SITE_CONFIG.urls.git} class="link">Git</a>
	</nav>
</footer>
