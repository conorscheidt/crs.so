---
import { PROJECTS } from "@shared/config";
---

<section class="reveal" data-lift>
	<header class="mb-6 flex items-baseline justify-between gap-4 border-t border-rule pt-3">
		<h2 class="sec-label"><span class="sec-num">§3</span>&ensp;Builds</h2>
		<span class="meta">selected</span>
	</header>

	<div class="grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
		{
			PROJECTS.map((p) => (
				<article>
					<div class="flex items-baseline justify-between gap-4 border-b border-rule-soft pb-2">
						<h3 class="display text-2xl text-ink">{p.name}</h3>
						<span class="cm text-base italic text-accent">{p.metric}</span>
					</div>
					<div class="meta mt-2">{p.stack}</div>
					<p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-ink-soft">{p.desc}</p>
				</article>
			))
		}
	</div>
</section>
