---
/**
 * Raster figure. Wraps Astro's <Image>, so post images are transformed at build
 * time (AVIF with WebP fallback, responsive widths, hashed immutable files),
 * and frames them like a live plate: same caption, same numbering.
 *
 * In MDX:
 *   import cover from "./my-shot.png";
 *   <Figure src={cover} alt="…" n={5} caption="…" />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
	/** an imported image (ImageMetadata), not a string path */
	src: ImageMetadata;
	/** required: this is content, not decoration */
	alt: string;
	caption?: string;
	/** figure number in the post's sequence (shared with <Fig>) */
	n?: number;
	/** add a hairline frame */
	border?: boolean;
	/** load eagerly at high priority (the LCP image) */
	priority?: boolean;
};
const { src, alt, caption, n, border = false, priority = false } = Astro.props;
const roman = n ? (["i", "ii", "iii", "iv", "v", "vi", "vii", "viii"][n - 1] ?? String(n)) : null;
---

<figure class:list={["afig", "araster", { bordered: border }]}>
	<Image
		src={src}
		alt={alt}
		widths={[440, 640, 880, 1280]}
		sizes="(min-width: 1080px) 640px, 92vw"
		format="avif"
		quality={72}
		loading={priority ? "eager" : "lazy"}
		fetchpriority={priority ? "high" : "auto"}
		decoding={priority ? "sync" : "async"}
	/>
	{
		caption && (
			<figcaption>
				{roman && <b>fig. {roman}</b>}
				{roman && " — "}
				{caption}
			</figcaption>
		)
	}
</figure>
