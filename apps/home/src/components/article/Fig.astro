---
/**
 * Interactive figure: a live canvas owned by a registered figure
 * implementation (src/figures/<kind>.ts). Direct manipulation happens in the
 * figure; prose binds via <b data-bind="param" data-fig="<id>"> spans for live
 * readouts and hover sync. No inline scrubbing.
 */
type Props = {
	kind: string;
	id: string;
	caption: string;
	n?: number;
	/** plates are naked by default; opt back into a hairline frame */
	border?: boolean;
};
const { kind, id, caption, n = 1, border = false } = Astro.props;
const roman = ["i", "ii", "iii", "iv", "v", "vi", "vii", "viii"][n - 1] ?? String(n);
---

<figure class:list={["afig", { bordered: border }]} data-fig-root={id} data-kind={kind}>
	<button type="button" class="disc figreset" data-fig-reset aria-label="Reset figure">
		<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
	</button>
	<div class="figmount" data-fig-mount></div>
	<figcaption><b>fig. {roman}</b> — {caption}</figcaption>
</figure>
