---
/**
 * Marginal note: wraps the exact phrase it remarks on. The phrase carries a
 * small ring marker, distinct from footnote numerals, and the note sits in the
 * right rail on that phrase's line, hover-synced both ways. Narrow viewports
 * render it as an inline aside instead.
 */
type Props = { note: string };
const { note } = Astro.props;
---

<span class="manchor" data-manchor
	><slot /><sup class="mmark" aria-hidden="true">∘</sup><span class="mnote" data-mnote hidden
		>{note}</span
	></span
>
