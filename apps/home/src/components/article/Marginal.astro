---
/**
 * Marginal note. Wraps the phrase it comments on. Notes take the symbol
 * sequence (* † ‡ § ‖ ¶) in document order from a CSS @counter-style, while
 * footnotes keep numerals. Hovering either side lights the other. The note
 * sits in the right rail beside its line, or inline on narrow screens.
 */
type Props = { note: string };
const { note } = Astro.props;
---

<span class="manchor" data-manchor
	><slot /><sup class="mmark" aria-hidden="true"></sup><span class="mnote" data-mnote hidden
		>{note}</span
	></span
>
