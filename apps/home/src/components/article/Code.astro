---
/**
 * Editable, runnable code block: CodeMirror with vim on by default, runs only
 * on an explicit ▶, real stdio. Stdin is an inline field in the output row,
 * passed to the vendored clang worker. Static blocks mount the same editor
 * read-only so every block renders identically.
 */
type Props = {
	lang: string;
	code: string;
	runnable?: boolean;
	/** show an stdin field beside the output (the program reads it) */
	stdin?: boolean;
};
const { lang, code, runnable = false, stdin = false } = Astro.props;
---

<div
	class:list={["codeblk", { static: !runnable }]}
	data-code
	data-lang={lang}
	data-runnable={runnable ? "" : undefined}
	data-stdin={stdin ? "" : undefined}
>
	{
		runnable ? (
			<div class="codehead">
				<span class="langtag">{lang}</span>
				<span class="vim-badge">vim</span>
				<button type="button" class="run" data-run aria-label="Compile and run">
					▶
				</button>
			</div>
		) : (
			<span class="langmark" aria-hidden="true">
				{lang}
			</span>
		)
	}
	<div class="codemount" data-mount></div>
	<pre class="codesrc" data-src hidden>{code}</pre>
	{
		runnable && (
			<div class="codeout" data-out hidden>
				{stdin && (
					<label class="stdinrow">
						<span>stdin</span>
						<input type="text" data-stdin-field spellcheck="false" />
					</label>
				)}
				<pre class="outtext" data-outtext />
			</div>
		)
	}
</div>
