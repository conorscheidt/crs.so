---
/**
 * Editable, runnable code block: CodeMirror with vim on by default, runs only
 * on an explicit ▶, real stdio. The output area is a terminal: stdout streams
 * in, and a blocked stdin read parks the program on an inline prompt
 * (SharedArrayBuffer). Static blocks mount the same editor read-only so every
 * block renders identically.
 */
type Props = {
	lang: string;
	code: string;
	runnable?: boolean;
};
// biome-ignore lint/correctness/noUnusedVariables: `code` renders in the template pre (template-usage false positive)
const { lang, code, runnable = false } = Astro.props;
---

<div
	class:list={["codeblk", { static: !runnable }]}
	data-code
	data-lang={lang}
	data-runnable={runnable ? "" : undefined}
>
	{
		runnable ? (
			<div class="codehead">
				<span class="langtag">{lang}</span>
				<span class="vim-badge">vim</span>
				<button type="button" class="disc run" data-run aria-label="Compile and run">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3" /></svg>
				</button>
			</div>
		) : (
			<span class="langmark" aria-hidden="true">
				{lang}
			</span>
		)
	}
	<div class="codemount" data-mount></div>
	<pre class="codesrc" data-src hidden>{code}</pre>
	{
		runnable && (
			<div class="codeout" data-out hidden>
				<pre class="outtext" data-outtext />
			</div>
		)
	}
</div>
