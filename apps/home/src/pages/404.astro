---
import Shell from "../layouts/Shell.astro";
---

<Shell
	title="Not found — Conor Scheidt"
	description="There is no page at this address."
	ogSlug="index"
	noindex
	scrollable
>
	<div class="lost">
		<p class="code">404</p>
		<p>There's no page at this address.</p>
		<a href="/">← crs.so</a>
	</div>
</Shell>

<script>
	import "../app";
</script>

<style>
	.lost {
		height: 100dvh;
		display: grid;
		place-content: center;
		text-align: center;
		gap: var(--s2);
	}
	.code {
		font-family: var(--font-display);
		font-weight: 130;
		font-variation-settings: "opsz" 144;
		font-size: 64px;
	}
	a {
		color: var(--ink);
	}
</style>
