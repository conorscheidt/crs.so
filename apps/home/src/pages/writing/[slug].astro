---
import { render } from "astro:content";
import Out from "../../components/Out.astro";
import { repoUrl } from "../../data/projects";
import Shell from "../../layouts/Shell.astro";
import { publishedPosts } from "../../lib/posts";
import { projectOf } from "../../lib/relations";

export async function getStaticPaths() {
	const all = await publishedPosts();
	return all.map((entry) => ({ params: { slug: entry.id }, props: { post: entry } }));
}

const { post } = Astro.props;
const project = projectOf(post);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
const hasToc = toc.length > 1;
const hasNotes = headings.some((h) => h.slug === "footnote-label");
const date = post.data.date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<Shell
	title={`${post.data.title} — Conor Scheidt`}
	description={post.data.description}
	scrollable
	article={{
		published: post.data.date,
		tags: post.data.tags,
		minutes: post.data.minutes,
	}}
>
	<div class="apage">
		<header class="arail-l">
			<a class="aname" href="/" data-astro-prefetch>Conor<br />Scheidt</a>
			<a class="aback" href="/writing" data-astro-prefetch>← writing</a>
			{
				hasToc && (
					<nav class="atoc" data-toc aria-label="Contents">
						<span class="atoc-track" aria-hidden="true">
							<span class="atoc-fill" data-toc-progress />
						</span>
						<div class="atoc-links">
							{toc.map((h) => (
								<a href={`#${h.slug}`} data-head={h.slug}>
									{h.text}
								</a>
							))}
						</div>
					</nav>
				)
			}
		</header>

		<article class="aprose" data-prose>
			<header class="ahead">
				<h1 class="press">{post.data.title}</h1>
				<p class="ameta">{date} · {post.data.minutes} min read</p>
				{
					(project || post.data.tags.length > 0) && (
						<div class="atags">
							{/* project first: a post has one, marked with the same `@` as search */}
							{project && (
								<a class="proj" href={`/writing?project=${project.slug}`}>
									@{project.slug}
								</a>
							)}
							{post.data.tags.map((t) => (
								<a href={`/writing?tag=${t}`}>{t}</a>
							))}
						</div>
					)
				}
				{
					project && (
						<p class="apro">
							Part of&#32;
							<a href={repoUrl(project.repo)} rel="noopener">
								{project.name}<Out />
							</a>
						</p>
					)
				}
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>

		<div class="arail-r" data-mrail></div>

		{/* narrow screens: where you are and how long is left, once the title is gone */}
		<div class="rhead" data-rhead data-minutes={post.data.minutes} inert>
			<p class="rhead-at" aria-hidden="true">
				<span class="rhead-sec" data-rhead-sec>{post.data.title}</span>
				<span class="rhead-left" data-rhead-left></span>
			</p>
			{
				hasToc && (
					<button
						type="button"
						class="rhead-btn"
						data-sheet-open
						aria-haspopup="dialog"
					>
						contents
					</button>
				)
			}
			<span class="rhead-bar" aria-hidden="true">
				<span class="rhead-fill" data-rhead-progress></span>
			</span>
		</div>

		{
			(hasToc || hasNotes) && (
				<dialog class="asheet" data-sheet data-lenis-prevent aria-label="Contents">
					<div class="asheet-scrim" data-sheet-scrim />
					<div class="asheet-panel" data-sheet-panel>
						<span class="asheet-grip" aria-hidden="true" />
						<div class="asheet-head">
							<p class="asheet-label" aria-hidden="true" data-sheet-label>
								contents
							</p>
							<button type="button" class="asheet-close" data-sheet-close>
								close
							</button>
						</div>
						<div class="asheet-scroll" data-sheet-scroll>
							{hasToc && (
								<ol class="asheet-toc" data-sheet-toc>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`} data-head={h.slug}>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							)}
							{/* footnotes on touch: filled from the notes section when a reference is tapped */}
							{hasNotes && (
								<div class="asheet-note" data-sheet-note hidden>
									<div class="asheet-notebody" data-sheet-notebody tabindex="-1" />
									<a class="asheet-all" href="#footnote-label" data-sheet-notelink>
										all notes ↓
									</a>
								</div>
							)}
						</div>
					</div>
				</dialog>
			)
		}
	</div>
</Shell>

<script>
	import "../../app";
</script>
