---
import { getCollection, render } from "astro:content";
import Shell from "../../layouts/Shell.astro";

export async function getStaticPaths() {
	const all = await getCollection("writing");
	return all.map((entry) => ({ params: { slug: entry.id }, props: { post: entry } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
const date = post.data.date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<Shell
	title={`${post.data.title} — Conor Scheidt`}
	description={post.data.description}
	scrollable
	article={{
		published: post.data.date,
		tags: post.data.tags,
		minutes: post.data.minutes,
	}}
>
	<div class="apage">
		<header class="arail-l">
			<a class="aname" href="/">Conor<br />Scheidt</a>
			<a class="aback" href="/writing">← writing</a>
			{
				toc.length > 1 && (
					<nav class="atoc" data-toc aria-label="Contents">
						<span class="atoc-track" aria-hidden="true">
							<span class="atoc-fill" data-toc-progress />
						</span>
						<div class="atoc-links">
							{toc.map((h) => (
								<a href={`#${h.slug}`} data-head={h.slug}>
									{h.text}
								</a>
							))}
						</div>
					</nav>
				)
			}
		</header>

		<article class="aprose" data-prose>
			<header class="ahead">
				<h1 class="press">{post.data.title}</h1>
				<p class="ameta">
					{date} · {post.data.minutes} min read
					{post.data.sample && <span> · sample</span>}
				</p>
				{
					post.data.tags.length > 0 && (
						<div class="atags">
							{post.data.tags.map((t) => (
								<a href={`/writing?tag=${t}`}>{t}</a>
							))}
						</div>
					)
				}
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>

		<div class="arail-r" data-mrail></div>
	</div>
</Shell>

<script>
	import "../../app";
</script>
