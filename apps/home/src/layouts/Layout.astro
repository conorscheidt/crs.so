---
import "@shared/global.css";
import "computer-modern/cmu-serif.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import SEO from "@shared/components/SEO.astro";
import { SITE_CONFIG } from "@shared/config";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = SITE_CONFIG.meta.title,
	description = `${SITE_CONFIG.meta.title} — ${SITE_CONFIG.meta.description}`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#faf8f1" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='30' fill='none' stroke='%231a1a17' stroke-width='6'/><circle cx='50' cy='50' r='9' fill='%231a1a17'/></svg>"
		/>
		<title>{title}</title>

		{/* Self-hosted fonts: subset + preload the above-the-fold variants only */}
			<Font cssVariable="--font-italiana" preload />
			<Font cssVariable="--font-spectral" preload={[{ weight: 400, style: "normal" }]} />
			<Font cssVariable="--font-jetbrains" preload={[{ style: "normal" }]} />

			<SEO title={title} description={description} />

		<script is:inline>
			// Apply the saved theme on first paint and after every view-transition swap
			// (the swap replaces <html>, dropping data-theme → theme would reset otherwise).
			// Prefer the .crsche.com cookie (shared across the homepage↔blog subdomains)
			// and fall back to per-origin localStorage.
			const readTheme = () => {
				const m = document.cookie.match(/(?:^|; )theme=(dark|light)/);
				return (m && m[1]) || localStorage.getItem("theme") || "dark";
			};
			const applyTheme = () => {
				const t = readTheme();
				document.documentElement.dataset.theme = t;
				// re-stamp the shared cookie so the choice rides along to the other subdomain
				const domain = location.hostname.endsWith("crsche.com") ? "; domain=.crsche.com" : "";
				document.cookie = `theme=${t}; path=/; max-age=31536000; samesite=lax${domain}`;
			};
			document.documentElement.classList.add("js");
			applyTheme();
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
		<ClientRouter />

		{/* Cloudflare Web Analytics — pageviews. Inert until PUBLIC_CF_BEACON is set. */}
		{
			import.meta.env.PUBLIC_CF_BEACON && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON}"}`}
				/>
			)
		}
	</head>
	<body class="grain bg-paper text-ink antialiased">
		<div class="bg-fixed" aria-hidden="true"><canvas id="sigil-canvas" data-figure></canvas></div>
		<div class="progress-bar" id="scroll-progress" aria-hidden="true"></div>
		<slot />
		<script src="@shared/scripts/main.ts"></script>
	</body>
</html>
