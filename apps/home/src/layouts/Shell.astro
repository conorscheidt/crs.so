---
import "../styles/global.css";
/* article surface styles live globally: hub ⇄ article is a same-document
   swap, so the destination's CSS must already be present */
import "katex/dist/katex.min.css";
import "../styles/article.css";
import spectralItalicUrl from "@fontsource/spectral/files/spectral-latin-300-italic.woff2?url";
import spectralUrl from "@fontsource/spectral/files/spectral-latin-300-normal.woff2?url";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url";

type Props = {
	title: string;
	description: string;
	scrollable?: boolean;
	/** social card slug under /og/ (defaults to the hub card for this route) */
	ogSlug?: string;
	/** present on article routes; drives BlogPosting structured data */
	article?: { published: Date; tags: string[]; minutes: number };
};
const { title, description, scrollable = false, ogSlug, article } = Astro.props;

const site = Astro.site ?? new URL("https://crs.so");
const canonical = new URL(Astro.url.pathname, site);
const ogPath = ogSlug ?? (Astro.url.pathname === "/" ? "index" : Astro.url.pathname.slice(1));
const ogImage = new URL(`/og/${ogPath}.png`, site);

/*
 * Cloudflare Web Analytics beacon token. Not a secret: it is public in the
 * page source of every site that uses one, so it is committed rather than
 * passed through an environment variable that would make dev and production
 * different builds. Empty means the script is not emitted at all. To turn
 * pageviews on: Analytics & Logs → Web Analytics → add crs.so, choose the
 * manual snippet (auto-install rewrites HTML at the edge, like Rocket
 * Loader), and paste the token out of it here.
 */
// biome-ignore lint/security/noSecrets: a public site tag, printed in the page
const CF_BEACON = "7d7cc357d0bb404a8db2d53475635150";

/*
 * Icons. The full set ships because an SVG favicon alone is not enough:
 * PDF tabs, older browsers, bookmark bars and most feed readers want
 * `favicon.ico`, and they request it from the site root without reading this
 * document's <link> tags. So it is declared first here and also lives at the
 * root. scripts/gen-favicon.ts emits all of them from one source so they
 * can't drift apart.
 */

const PERSON = {
	"@type": "Person",
	"@id": "https://crs.so/#person",
	name: "Conor Scheidt",
	url: "https://crs.so",
	email: "mailto:c@crs.so",
	sameAs: ["https://github.com/conorscheidt", "https://linkedin.com/in/conorscheidt"],
	jobTitle: "Software Engineer",
	knowsAbout: ["compilers", "GPU simulation", "mathematics"],
};

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		PERSON,
		{
			"@type": "WebSite",
			"@id": "https://crs.so/#site",
			url: "https://crs.so",
			name: "Conor Scheidt",
			publisher: { "@id": "https://crs.so/#person" },
			inLanguage: "en",
		},
		...(article
			? [
					{
						"@type": "BlogPosting",
						headline: title.replace(" — Conor Scheidt", ""),
						description,
						datePublished: article.published.toISOString(),
						dateModified: article.published.toISOString(),
						author: { "@id": "https://crs.so/#person" },
						publisher: { "@id": "https://crs.so/#person" },
						mainEntityOfPage: canonical.href,
						image: ogImage.href,
						keywords: article.tags.join(", "),
						timeRequired: `PT${article.minutes}M`,
						isPartOf: { "@id": "https://crs.so/#site" },
					},
				]
			: []),
	],
});
---

<html lang="en" data-theme="night">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Conor Scheidt" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{article && <meta property="article:published_time" content={article.published.toISOString()} />}
		{article?.tags.map((t) => <meta property="article:tag" content={t} />)}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#171310" />
		<link rel="alternate" type="application/rss+xml" title="Conor Scheidt — Writing" href="/rss.xml" />
		<script type="application/ld+json" set:html={jsonLd} />
		{
			/* Cookieless pageviews, no consent banner required, ~2 KB. `type=module`
			   matches the snippet Cloudflare hands out and defers by definition, so
			   there is no `defer` to add. It is a cross-origin script under COEP
			   `credentialless`, which loads it without credentials rather than
			   blocking it — verified against the live site, not assumed. */
			CF_BEACON && (
				<script
					is:inline
					type="module"
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token":"${CF_BEACON}"}`}
				/>
			)
		}
		<!-- Pre-paint: decide the theme before first paint. Night is the default and
		     prefers-color-scheme is ignored. Mirrors resolveTheme in src/theme.ts. -->
		<script is:inline>
			(() => {
				let t = null;
				try {
					t = localStorage.getItem("crs-theme");
				} catch {}
				const d = document.documentElement;
				d.classList.add("js");
				d.dataset.theme = t === "day" ? "day" : "night";
				// pre-paint cursor class too: cross-document clicks otherwise flash
				// the native cursor while the new page boots
				if (
					matchMedia("(pointer: fine)").matches &&
					!matchMedia("(prefers-reduced-motion: reduce)").matches
				) {
					d.classList.add("no-native-cursor");
				}
			})();
		</script>
		<link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={spectralUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={spectralItalicUrl} as="font" type="font/woff2" crossorigin />
	</head>
	<body class:list={[{ scrollable }]}>
		<main>
			<slot />
		</main>
	</body>
</html>
