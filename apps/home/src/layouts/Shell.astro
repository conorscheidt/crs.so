---
import { Font } from "astro:assets";
import "../styles/global.css";
// Article styles load everywhere: hub ⇄ article is a same-document swap, so
// the destination's CSS has to be present before the swap happens.
import "katex/dist/katex.min.css";
import "../styles/article.css";

type Props = {
	title: string;
	description: string;
	scrollable?: boolean;
	/** Social card under /og/; defaults to the card for this route. */
	ogSlug?: string;
	/** Set on article routes; adds BlogPosting structured data. */
	article?: { published: Date; tags: string[]; minutes: number };
	/** Keep the page out of search results. */
	noindex?: boolean;
};
const { title, description, scrollable = false, ogSlug, article, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://crs.so");
const canonical = new URL(Astro.url.pathname, site);
const ogPath = ogSlug ?? (Astro.url.pathname === "/" ? "index" : Astro.url.pathname.slice(1));
const ogImage = new URL(`/og/${ogPath}.png`, site);

// Cloudflare Web Analytics site token. It ships in the page anyway, so it
// isn't an env var.
// biome-ignore lint/security/noSecrets: public site token
const CF_BEACON = "7d7cc357d0bb404a8db2d53475635150";

const person = "https://crs.so/#person";
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": person,
			name: "Conor Scheidt",
			url: "https://crs.so",
			email: "mailto:c@crs.so",
			sameAs: ["https://github.com/conorscheidt", "https://linkedin.com/in/conorscheidt"],
			affiliation: { "@type": "CollegeOrUniversity", name: "Northwestern University" },
			knowsAbout: ["distributed systems", "compilers", "numerical methods", "trading systems"],
		},
		{
			"@type": "WebSite",
			"@id": "https://crs.so/#site",
			url: "https://crs.so",
			name: "Conor Scheidt",
			publisher: { "@id": person },
			inLanguage: "en",
		},
		...(article
			? [
					{
						"@type": "BlogPosting",
						headline: title.replace(" — Conor Scheidt", ""),
						description,
						datePublished: article.published.toISOString(),
						dateModified: article.published.toISOString(),
						author: { "@id": person },
						publisher: { "@id": person },
						mainEntityOfPage: canonical.href,
						image: ogImage.href,
						keywords: article.tags.join(", "),
						timeRequired: `PT${article.minutes}M`,
						isPartOf: { "@id": "https://crs.so/#site" },
					},
				]
			: []),
	],
});

// The pre-paint script below runs before first paint and can't import, so it
// inlines theme.ts#resolveTheme and the cursor gate from cursor.ts.
---

<html lang="en" data-theme="night">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={article ? "article" : "website"} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:site_name" content="Conor Scheidt" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{article && <meta property="article:published_time" content={article.published.toISOString()} />}
		{article?.tags.map((t) => <meta property="article:tag" content={t} />)}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#171310" />
		<link rel="alternate" type="application/rss+xml" title="Conor Scheidt — Writing" href="/rss.xml" />
		<script type="application/ld+json" set:html={jsonLd} />
		<script is:inline>
			(() => {
				let t = null;
				try {
					t = localStorage.getItem("crs-theme");
				} catch {}
				const d = document.documentElement;
				const theme = t === "day" ? "day" : "night";
				d.classList.add("js");
				d.dataset.theme = theme;
				if (theme === "day") {
					document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#f2f0ea");
				}
				if (matchMedia("(pointer: fine)").matches) d.classList.add("no-native-cursor");
			})();
		</script>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-text" preload />
		<Font cssVariable="--font-mark" />
		{
			CF_BEACON && (
				<script
					is:inline
					type="module"
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token":"${CF_BEACON}"}`}
				/>
			)
		}
	</head>
	<body class:list={[{ scrollable }]}>
		<main>
			<slot />
		</main>
	</body>
</html>
