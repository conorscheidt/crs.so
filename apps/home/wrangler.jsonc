{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "crs-so",
	"account_id": "6c64fbba2f7c923fee733375e4f5e5f6",
	"compatibility_date": "2026-10-06",
	"main": "./worker/index.ts",
	"upload_source_maps": true,

	// No Smart Placement: it moves a Worker toward its backend, and this one has
	// none. Assets never reach it and Analytics Engine writes are local.

	// The apex is the only hostname. www is a proxied placeholder record with a
	// redirect at the edge, so the Worker never runs for it.
	"routes": [{ "pattern": "crs.so", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,

	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		// matches Astro's trailingSlash: "never"
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},

	// Cache in front of the Worker, keyed by version and driven by the
	// responses' Cache-Control. /api/git is served from it; POSTs pass through.
	"cache": { "enabled": true },

	"analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "crs_so_events" }],

	// The Worker only runs for /api/* and unmatched paths, so sample everything.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true },
		"issues": { "enabled": true }
	},

	"send_metrics": false
}
