{
	// Cloudflare Workers Static Assets. One Worker, one deploy: `bun run deploy`.
	// The script exists only to answer /api/e; assets are served from the edge
	// without invoking it, so page loads are unaffected.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "crs-so",
	"compatibility_date": "2026-06-19",
	"main": "./worker.ts",

	// The apex is the only address this site answers on. Without this, the deploy
	// is also reachable at crs-so.<subdomain>.workers.dev, a second crawlable
	// copy of every page. The canonical tags point home, but the cheaper fix is
	// for the duplicate not to exist. `custom_domain: true` has Wrangler create
	// and own the DNS record, so the binding lives in this file rather than in
	// dashboard state nobody can diff.
	"routes": [{ "pattern": "crs.so", "custom_domain": true }],
	"workers_dev": false,
	// Defaults to workers_dev; stated anyway, because a preview URL is a public URL.
	"preview_urls": false,

	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Everything else is served as an asset without the script running. Only
		// this prefix is routed to the Worker first.
		"run_worker_first": ["/api/*"],
		// matches astro's `trailingSlash: "never"`: one URL per page
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},

	// Behaviour events. Created on first deploy; no dashboard, query it with the
	// SQL API.
	"analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "crs_so_events" }],

	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.5
	}
}
