# Build-time configuration. Both are optional and both are public: they are
# inlined into the bundle by Vite, so never put a secret behind this prefix.
# Copy to `.env` locally, or set them as build variables in Workers Builds.
# Neither is needed for the site to work; each turns on one half of analytics.

# Cloudflare Web Analytics beacon token → pageviews. Dashboard: Analytics &
# Logs → Web Analytics → add crs.so → copy the token out of the snippet.
# Unset, the beacon script is not emitted at all.
PUBLIC_CF_BEACON=

# URL of the deployed workers/analytics sink → behaviour events (which posts
# get finished, which snippets get run, what people search for). Unset,
# `track()` returns before it does anything.
PUBLIC_ANALYTICS_URL=
