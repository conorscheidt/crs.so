# Cross-origin isolation lets the clang worker block on a SharedArrayBuffer for
# stdin. require-corp rather than credentialless because Safari only supports
# the former; the one cross-origin subresource (the Web Analytics beacon) sends
# CORP: cross-origin.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Content-hashed by the bundler.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The clang toolchain is versioned by directory; bump it to ship a new one.
/clang/v1/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/rss.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/rss+xml; charset=utf-8
/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=604800, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate
/icon-*.png
  Cache-Control: public, max-age=604800, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
/Conor_Scheidt_Resume.pdf
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Disposition: inline; filename="Conor_Scheidt_Resume.pdf"

# HTML keeps the asset default (max-age=0, must-revalidate, ETag), so a deploy
# shows up immediately.
