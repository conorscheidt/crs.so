---
import { SITE_CONFIG } from "@shared/config";

const nav = [
	{ label: "Résumé", href: SITE_CONFIG.urls.resume },
	{ label: "GitHub", href: SITE_CONFIG.urls.github },
	{ label: "Git", href: SITE_CONFIG.urls.git },
	{ label: "Writing", href: SITE_CONFIG.urls.blog },
	{ label: "Contact", href: `mailto:${SITE_CONFIG.meta.email}` },
];
---

<header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-5">
	<a href="/" class="cm shrink-0 whitespace-nowrap text-lg text-ink" aria-label="Conor Scheidt — home">C.&thinsp;Scheidt</a>
	<nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] sm:gap-x-7 sm:text-[14px]">
		{nav.map((n) => <a href={n.href} class="link">{n.label}</a>)}
		<button type="button" class="theme-toggle" data-theme-toggle data-magnetic aria-label="Toggle dark/light">
			<svg class="ic-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.4" fill="currentColor" /><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.1 5.1l1.8 1.8M17.1 17.1l1.8 1.8M5.1 18.9l1.8-1.8M17.1 6.9l1.8-1.8" /></g></svg><svg class="ic-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" /></svg>
		</button>
	</nav>
</header>
