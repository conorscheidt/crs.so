---
import Constructs from "../components/Constructs.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Provenance from "../components/Provenance.astro";
import ServiceRecord from "../components/ServiceRecord.astro";
import Signal from "../components/Signal.astro";
import StatusBar from "../components/StatusBar.astro";
import Layout from "../layouts/Layout.astro";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=3600, must-revalidate");
---

<Layout>
	<main class="mx-auto w-full max-w-[1100px] px-6 md:px-10">
		<StatusBar />
		<Hero />

		<div class="over-art flex flex-col gap-24 pt-10 pb-28 md:gap-32">
			<Signal />
			<ServiceRecord />
			<Constructs />
			<Provenance />
			<Footer />
		</div>
	</main>
</Layout>
