---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Conor Scheidt" description="Page not found.">
	<main
		class="over-art mx-auto flex min-h-[82vh] w-full max-w-[1100px] flex-col items-start justify-center px-6 md:px-10"
	>
		<p class="caption mb-3">Fig.&thinsp;404 — signal lost</p>
		<h1 class="display blend text-[30vw] leading-[0.8] sm:text-[20vw] lg:text-[220px]">404</h1>
		<p class="mt-7 max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">
			This page slipped past the horizon — renamed, moved, or never written.
		</p>
		<a href="/" class="link mt-6 text-[15px]">← back to start</a>
	</main>
</Layout>
