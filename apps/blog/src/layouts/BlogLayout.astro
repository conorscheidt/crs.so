---
import "@shared/global.css";
import "@shared/prose.css";
import "computer-modern/cmu-serif.css";
import "katex/dist/katex.min.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import SEO from "@shared/components/SEO.astro";
import { SITE_CONFIG } from "@shared/config";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** landing page → also draw the eclipse sphere + ring figure over the drift */
	figure?: boolean | undefined;
	/** post pages pass article metadata for rich OpenGraph + BlogPosting JSON-LD */
	type?: "website" | "article" | undefined;
	publishedTime?: Date | undefined;
	modifiedTime?: Date | undefined;
	tags?: string[] | undefined;
}

const {
	title = "Notes — Conor Scheidt",
	description = "Writing on systems, quantitative work, and the mathematics underneath.",
	figure = false,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
} = Astro.props;

const home = SITE_CONFIG.urls.home;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#faf8f1" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='30' fill='none' stroke='%231a1a17' stroke-width='6'/><circle cx='50' cy='50' r='9' fill='%231a1a17'/></svg>"
		/>
		<title>{title}</title>
		<SEO
			title={title}
			description={description}
			type={type}
			siteName="Notes — Conor Scheidt"
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			tags={tags}
		/>

			<!-- Self-hosted fonts: subset + preload the above-the-fold variants only -->
			<Font cssVariable="--font-italiana" preload />
			<Font cssVariable="--font-spectral" preload={[{ weight: 400, style: "normal" }]} />
			<Font cssVariable="--font-jetbrains" preload={[{ style: "normal" }]} />

		<script is:inline>
			// Apply the saved theme on first paint and after every view-transition swap
			// (the swap replaces <html>, dropping data-theme → theme would reset otherwise).
			// Prefer the .crsche.com cookie (shared across the homepage↔blog subdomains)
			// and fall back to per-origin localStorage.
			const readTheme = () => {
				const m = document.cookie.match(/(?:^|; )theme=(dark|light)/);
				return (m?.[1]) || localStorage.getItem("theme") || "dark";
			};
			const applyTheme = () => {
				const t = readTheme();
				document.documentElement.dataset.theme = t;
				// re-stamp the shared cookie so the choice rides along to the other subdomain
				const domain = location.hostname.endsWith("crsche.com") ? "; domain=.crsche.com" : "";
				document.cookie = `theme=${t}; path=/; max-age=31536000; samesite=lax${domain}`;
			};
			document.documentElement.classList.add("js");
			applyTheme();
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
		<ClientRouter />

		<!-- Cloudflare Web Analytics — pageviews. Inert until PUBLIC_CF_BEACON is set. -->
		{
			import.meta.env.PUBLIC_CF_BEACON && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON}"}`}
				/>
			)
		}
	</head>
	<body class="grain bg-paper text-ink antialiased">
		<!-- background drift on every blog page; the eclipse figure only on the landing -->
		<div class="bg-fixed" aria-hidden="true">
			<canvas id="sigil-canvas" data-variant="ambient" data-figure={figure ? "" : undefined}></canvas>
		</div>
		<div class="progress-bar" id="scroll-progress" aria-hidden="true"></div>

		<nav class="mx-auto flex w-full max-w-[1100px] items-center justify-between px-6 py-5 md:px-10">
			<a href={home} class="link text-[14px]">← crsche.com</a>
			<div class="flex items-center gap-6">
				<a href="/" class="cm text-lg text-ink" data-magnetic>Notes</a>
				<button type="button" class="theme-toggle" data-theme-toggle data-magnetic aria-label="Toggle dark/light">
					<svg class="ic-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.4" fill="currentColor" /><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.1 5.1l1.8 1.8M17.1 17.1l1.8 1.8M5.1 18.9l1.8-1.8M17.1 6.9l1.8-1.8" /></g></svg><svg class="ic-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" /></svg>
				</button>
			</div>
		</nav>

		<slot />

		<footer class="mx-auto mt-24 flex w-full max-w-[1100px] flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t border-rule px-6 py-10 md:px-10">
			<span class="meta">© {new Date().getFullYear()} Conor Scheidt</span>
			<a href={home} class="link text-[14px]">crsche.com ↗</a>
		</footer>

		<script src="@shared/scripts/main.ts"></script>
	</body>
</html>
