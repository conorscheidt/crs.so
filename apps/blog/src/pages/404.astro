---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="404 — Notes" description="Page not found.">
	<main
		class="over-art mx-auto flex min-h-[72vh] w-full max-w-[1100px] flex-col items-start justify-center px-6 pt-16 md:px-10"
	>
		<p class="caption mb-3">Fig.&thinsp;404 — page not found</p>
		<h1 class="display blend text-[28vw] leading-[0.82] sm:text-[18vw] lg:text-[200px]">404</h1>
		<p class="mt-7 max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">
			No note lives at this address. It may have been renamed, or never written.
		</p>
		<a href="/" class="link mt-6 text-[15px]">← all notes</a>
	</main>
</BlogLayout>
