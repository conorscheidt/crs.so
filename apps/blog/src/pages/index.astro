---
import { getCollection } from "astro:content";
import { formatDate } from "@shared/config";
import BlogLayout from "../layouts/BlogLayout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=3600, must-revalidate");
---

<BlogLayout figure>
	<main class="mx-auto w-full max-w-[1100px] px-6 pt-16 pb-12 md:px-10 md:pt-24">
		<header class="over-art mb-12 md:mb-16">
			<p class="caption mb-4">Engineering log</p>
			<h1 class="display blend text-[16vw] leading-[0.84] sm:text-[12vw] lg:text-[140px]">Notes</h1>
			<p class="mt-6 max-w-[52ch] text-[15px] leading-relaxed text-ink-soft">
				Writing on systems, quantitative work, and the mathematics underneath —
				with figures and code you can run.
			</p>
		</header>

		<!-- search · sort · tag filter — fully client-side, instant -->
		<div class="over-art mb-7 flex flex-wrap items-center gap-x-6 gap-y-3" data-blog-controls>
			<label class="relative flex-1 min-w-[180px]">
				<input
					type="search"
					data-search
					placeholder="search title, summary, tag…"
					class="w-full border-b border-rule bg-transparent py-1.5 text-[14px] text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none"
					aria-label="Search posts"
				/>
			</label>
			<div class="flex items-center gap-2 meta">
				<span id="sort-label">sort</span>
				<div class="xselect" data-select data-sort>
					<button
						type="button"
						class="xselect-btn"
						data-select-btn
						data-magnetic
						aria-haspopup="listbox"
						aria-expanded="false"
						aria-labelledby="sort-label"
					>
						<span data-select-value>newest</span>
						<svg class="xselect-caret" viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</button>
					<ul class="xselect-pop" data-select-pop aria-label="Sort posts">
						<li class="xselect-opt" data-select-opt data-value="new" aria-selected="true">newest</li>
						<li class="xselect-opt" data-select-opt data-value="old" aria-selected="false">oldest</li>
						<li class="xselect-opt" data-select-opt data-value="title" aria-selected="false">title</li>
					</ul>
				</div>
			</div>
		</div>

		{
			allTags.length > 0 && (
				<div class="over-art mb-2 flex flex-wrap items-center gap-2" data-tag-bar>
					<button type="button" class="tag-chip is-active" data-tag-chip="" data-magnetic>
						all
					</button>
					{allTags.map((tag) => (
						<button type="button" class="tag-chip" data-tag-chip={tag} data-magnetic>
							{tag}
						</button>
					))}
				</div>
			)
		}

		<ol class="over-art border-t border-rule" data-post-list>
			<li class="meta hidden py-16 text-ink-faint" data-empty>No posts match.</li>
			{
				posts.map((post, i) => (
					<li
						data-post
						data-title={post.data.title.toLowerCase()}
						data-tags={post.data.tags.join(",").toLowerCase()}
						data-desc={post.data.description.toLowerCase()}
						data-date={post.data.pubDate.valueOf()}
					>
						<a
							href={`/${post.id}/`}
							class="group grid grid-cols-1 gap-x-10 gap-y-2 border-b border-rule-soft py-9 transition-colors duration-300 md:grid-cols-[8rem_1fr]"
							data-magnetic
						>
							<div class="pt-1.5">
								<div class="meta text-accent">№ {String(posts.length - i).padStart(2, "0")}</div>
								<div class="meta mt-1">{formatDate(post.data.pubDate)}</div>
							</div>
							<div>
								<h2 class="display text-2xl text-ink transition-colors duration-300 group-hover:text-accent md:text-3xl">
									{post.data.title}
								</h2>
								<p class="mt-2 max-w-[64ch] text-[15px] leading-relaxed text-ink-soft">
									{post.data.description}
								</p>
								<div class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
									{post.data.tags.map((tag) => (
										<button type="button" class="post-tag" data-tag-chip={tag}>
											{tag}
										</button>
									))}
								</div>
							</div>
						</a>
					</li>
				))
			}
		</ol>
	</main>
	<script src="@shared/scripts/blog-index.ts"></script>
</BlogLayout>
