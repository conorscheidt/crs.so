---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { formatDate } from "@shared/config";
import BlogLayout from "../layouts/BlogLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

Astro.response.headers.set("Cache-Control", "public, max-age=3600");
---

<BlogLayout
	title={`${post.data.title} — Conor Scheidt`}
	description={post.data.description}
	type="article"
	publishedTime={post.data.pubDate}
	modifiedTime={post.data.updatedDate}
	tags={post.data.tags}
>
	{
		toc.length > 1 && (
			<nav class="toc" aria-label="Contents" data-toc>
				<p class="toc-label">Contents</p>
				<ol>
					{toc.map((h) => (
						<li class={`toc-d${h.depth}`}>
							<a href={`#${h.slug}`} data-toc-link={h.slug}>
								{h.text}
							</a>
						</li>
					))}
				</ol>
			</nav>
		)
	}
	<main class="over-art mx-auto w-full max-w-[1100px] px-6 pt-10 pb-16 md:px-10">
		<header class="mx-auto mb-10 max-w-[72ch]" data-lift>
			<a href="/" class="link text-[14px]">← all notes</a>
			<div class="meta mt-8 mb-5 flex flex-wrap items-center gap-x-3 gap-y-1">
				<span>{formatDate(post.data.pubDate, { year: "numeric", month: "long", day: "numeric" })}</span>
				<span class="text-ink-faint">·</span>
				{
					post.data.tags.map((t) => (
						<a href={`/?tag=${encodeURIComponent(t)}`} class="post-tag" data-magnetic>
							{t}
						</a>
					))
				}
			</div>
			<h1 class="display text-4xl leading-[1.02] text-ink md:text-6xl">{post.data.title}</h1>
			<p class="cm mt-5 max-w-[52ch] text-lg italic text-ink-muted">{post.data.description}</p>
		</header>

		<div class="mx-auto mb-12 max-w-[72ch] border-t border-rule"></div>

		<article class="prose" data-lift>
			<Content />
		</article>
	</main>
</BlogLayout>
