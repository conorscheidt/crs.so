---
/** Interactive figure shell — ruled frame, "live" stamp, paper backdrop. */
interface Props {
	caption?: string;
	class?: string;
}
const { caption, class: className = "" } = Astro.props;
---

<figure class:list={["not-prose my-10", className]}>
	<div class="border-y border-rule bg-paper-2/60">
		<div class="flex items-center justify-between border-b border-rule-soft px-4 py-2.5">
			<span class="meta">Interactive figure</span>
			<span class="meta flex items-center gap-1.5 text-accent">
				<span class="live-dot"></span> live
			</span>
		</div>
		<div class="p-5 md:p-6">
			<slot />
		</div>
	</div>
	{
		caption && (
			<figcaption class="caption mt-3 text-center">
				<span class="text-accent">{caption.split("—")[0]?.trim()}</span>
				{caption.includes("—") ? ` — ${caption.split("—").slice(1).join("—").trim()}` : ""}
			</figcaption>
		)
	}
</figure>
