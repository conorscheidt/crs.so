---
/**
 * Distill-style cross-reference. Wraps an inline term and links it to figure
 * element(s) sharing the same `id` (marked `data-xref="<id>"`). Hover/focus
 * either side and every match lights up — text ↔ diagram, both directions.
 * Behaviour is wired globally in shared/scripts/main.ts.
 */
interface Props {
	id: string;
}
const { id } = Astro.props;
---

<span class="xref" data-xref={id} tabindex="0" role="link">
	<slot />
</span>
